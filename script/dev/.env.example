# ========================================
# 辰栈环境变量配置文件示例
# ========================================
#
# 使用说明：
# 1. 将本模板复制为 script/dev/.env；勿复用后端或生产目录的私人配置
# 2. 根据您的实际环境修改下面的配置
# 3. 使用本目录 docker-compose.yml；部署和启动由用户在审查通过后执行
#
# 注意事项：
# - .env 文件包含敏感信息，不应提交到 Git 仓库
# - 生产环境请务必修改所有默认密码
# - 邮件和阿里云配置需要填入真实的账号信息
# - 拆分启动基础服务和应用服务时，可忽略由另一 Compose 文件管理的容器
#
# ========================================

# 拆分启动基础服务和应用服务时，忽略由另一 Compose 文件管理的容器
COMPOSE_IGNORE_ORPHANS=true

# ========================================
# Spring Boot 应用配置
# ========================================
# 普通开发使用 dev；rag Profile 仅加载RAG配置，仍须显式启用业务开关。
SPRING_PROFILES_ACTIVE=dev

# ========================================
# 数据库配置 (MySQL 8.0)
# ========================================
# MySQL root 用户密码（管理员密码）
MYSQL_ROOT_PASSWORD=

# 应用使用的数据库名称
MYSQL_DATABASE=chen_stack

# 应用连接数据库的用户名
MYSQL_USER=chenstack

# 应用连接数据库的密码
MYSQL_PASSWORD=

# MySQL 对外暴露的端口（默认 3306）
MYSQL_PORT=3308

# ========================================
# Redis 缓存配置
# ========================================
# Redis 用户名（用于缓存和会话存储）
REDIS_USERNAME=chenstack

# Redis 访问密码
REDIS_PASSWORD=

# Redis 对外暴露的端口（默认 6379）
REDIS_PORT=6379

# ========================================
# MinIO 对象存储配置
# ========================================
# MinIO 访问密钥（用于文件上传存储）
MINIO_ACCESS_KEY=chenstack

# MinIO 密钥
MINIO_SECRET_KEY=

# MinIO API 端口（默认 9000）
MINIO_API_PORT=9000

# MinIO 控制台端口（默认 9001）
MINIO_CONSOLE_PORT=9001

# MinIO 公网访问地址（用于生成文件访问 URL）
MINIO_PUBLIC_POINT=http://localhost:9000

# ========================================
# RabbitMQ 消息队列配置
# ========================================
# RabbitMQ 管理员用户名（用于异步消息处理）
RABBITMQ_DEFAULT_USER=guest

# RabbitMQ 管理员密码
RABBITMQ_DEFAULT_PASS=

# RabbitMQ 服务端口（默认 5672）
RABBITMQ_PORT=5672

# RabbitMQ 管理界面端口（默认 15672）
RABBITMQ_MANAGEMENT_PORT=15672

# ========================================
# AI 服务配置 (DeepSeek)
# ========================================
# DeepSeek API Key（用于 AI 功能，如文章摘要生成）
# 获取方式：https://platform.deepseek.com/api_keys
SPRING_AI_OPENAI_API_KEY=

# DeepSeek API 地址（默认使用官方地址）
SPRING_AI_OPENAI_BASE_URL=https://api.deepseek.com

# 默认：deepseek-flash（V4.1 Flash）
# 可选：deepseek-v4-pro
SPRING_AI_OPENAI_CHAT_OPTIONS_MODEL=deepseek-flash

# 问答固定知识模式：chat 不检索；rag 使用 G2；wiki 只使用当前合法已发布 Wiki。
# hybrid / auto 尚未实现，启用时启动报错；非法值同样拒绝，不回退到 rag。
AI_KNOWLEDGE_MODE=rag
# wiki 模式要求已批准的 Wiki SQL/触发器已部署，再显式启用两个开关。
# 修改环境变量后必须 recreate backend；不需要编译 Wiki 或重建知识/向量库。
CHEN_WIKI_ENABLED=false
CHEN_WIKI_PRODUCT_ENABLED=false
# 只控制公开 Wiki 阅读入口及 API，不影响后台审核或小辰的合法知识读取。
WIKI_PUBLIC_PORTAL_ENABLED=false

# 百炼 Embedding（北京，Workspace ID=ws-oy47ndolze5z0j6p，兼容接口，固定1024维）
# Compose 从本目录 .env 读取并传入后端；仅填写独立Key不会启用RAG或同步知识。
# 未来启用须显式设置 SPRING_PROFILES_ACTIVE=dev,rag 与 CHEN_RAG_ENABLED=true。
# DeepSeek Chat Key、百炼 Embedding Key、内容审核 ALIYUN_ACCESS_KEY_* 三套凭据互不复用。
CHEN_RAG_ENABLED=false
# Chat Provider 累计 HTTP 调用上限，不按天重置；变更须匹配持久账本的审计扩容记录。
CHEN_RAG_RELEASE_MAX_CHAT_HTTP_ATTEMPTS=100
CHEN_RAG_EMBEDDING_API_KEY=
CHEN_RAG_EMBEDDING_BASE_URL=https://ws-oy47ndolze5z0j6p.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
CHEN_RAG_EMBEDDING_MODEL=text-embedding-v4

# ========================================
# 邮件服务配置
# ========================================
# 发送邮件的邮箱地址（用于用户注册、密码重置等功能）
# 支持：QQ邮箱、Gmail、163邮箱等
MAIL_USERNAME=your-email@qq.com

# 邮箱密码或授权码
# QQ邮箱：需要使用授权码，不是QQ密码
# Gmail：需要开启两步验证并生成应用专用密码
MAIL_PASSWORD=

# ========================================
# 前端地址配置
# ========================================
# 用户端前端地址
FRONTEND_USER_HOST=http://localhost:7000/

# 管理端前端地址
FRONTEND_ADMIN_HOST=http://localhost:8000/

# ========================================
# 阿里云服务配置
# ========================================
# 阿里云 AccessKey ID（用于图片内容安全检测）
# 获取方式：阿里云控制台 -> 用户信息 -> AccessKey 管理
ALIYUN_ACCESS_KEY_ID=

# 阿里云 AccessKey Secret
ALIYUN_ACCESS_KEY_SECRET=

# ========================================
# 应用自定义配置
# ========================================
# JWT 令牌签名密钥（用于用户身份认证）
# 生产环境请使用复杂的随机字符串
CHEN_STACK_JWT_SECRET=

# 图片自动审核开关
CHEN_STACK_PHOTO_AUTO_AUDIT=false

# 文章自动审核开关
CHEN_STACK_ARTICLE_AUTO_AUDIT=true

# 评论自动审核开关
CHEN_STACK_COMMENT_AUTO_AUDIT=false

# 限流开关（压力测试时设为 false）
CHEN_STACK_RATE_LIMIT_ENABLED=true

# ========================================
# 应用服务端口配置
# ========================================
# 后端 API 服务端口（默认 5000）
BACKEND_PORT=5000

# 管理端前端端口（默认 8000）
ADMIN_PORT=8000

# 用户端前端端口（默认 7000）
USER_PORT=7000


# ========================================
# 配置修改建议
# ========================================
#
# 开发环境建议：
# - 可以使用默认密码和端口进行本地开发
# - 邮件配置可以先跳过，使用测试邮箱
# - 端口冲突时可以修改为其他端口
#
# 生产环境必须修改：
# - 所有密码都要使用强密码（包含大小写字母、数字、特殊字符）
# - CHEN_STACK_JWT_SECRET 使用长随机字符串
# - 邮件配置填入真实可用的邮箱
# - 阿里云配置填入真实的 AccessKey
# - AI 服务配置填入真实的 DeepSeek API Key
# - 根据服务器情况调整端口配置
#
# 强密码示例：
# MYSQL_ROOT_PASSWORD=<SET_IN_PROTECTED_LOCAL_ENV>
# REDIS_PASSWORD=<SET_IN_PROTECTED_LOCAL_ENV>
# CHEN_STACK_JWT_SECRET=<SET_IN_PROTECTED_LOCAL_ENV>
#



# 端口配置示例（避免冲突）：
# MYSQL_PORT=33061
# REDIS_PORT=63791
# MINIO_API_PORT=90001
# MINIO_CONSOLE_PORT=90011
# RABBITMQ_PORT=56721
# RABBITMQ_MANAGEMENT_PORT=156721
# BACKEND_PORT=50001
# ADMIN_PORT=80001
# USER_PORT=70001
#
# ========================================

# Qdrant独立部署：容器内开启RAG时必须填写后端容器可达的地址与端口。
# 127.0.0.1仅适用于后端进程与Qdrant同机直连；Docker不会自动连通独立RAG网络。
# docker-compose-rag.yml默认向宿主机映射gRPC 16334；按实际部署修改，不自动创建生产索引。
CHEN_RAG_QDRANT_HOST=127.0.0.1
CHEN_RAG_QDRANT_GRPC_PORT=6334
CHEN_RAG_QDRANT_TLS=false
CHEN_RAG_QDRANT_API_KEY=
CHEN_RAG_QDRANT_COLLECTION=chen_platform_help_v1
