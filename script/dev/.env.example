# 辰栈本地 Docker Compose 配置模板
# 从仓库根目录用 PowerShell 7 执行：
#   pwsh -File script/deploy/ChenStack.ps1 -Action init
# init 会生成 .runtime/<实例名>/.env（默认实例 dev），填充空的本地凭据，
# 创建 Redis 私有配置和账本目录，并应用数据库迁移。
# 之后在生成的 env 配置可选服务，已有普通实例按部署手册应用配置。
# .env 和 .runtime 已被 Git 忽略。切勿提交凭据。
# script/dev/.env 是旧默认实例的兼容位置，仅在新路径不存在时读取。
# 手工使用 Compose 需明确传入 --env-file，准备密码、Redis 文件、账本目录及迁移。
# 正式 RAG 发布见 script/release/README.md。
# 拆分启动基础服务和应用服务时，忽略由另一 Compose 文件管理的容器
COMPOSE_IGNORE_ORPHANS=true

# ========================================
# Spring Boot 应用配置
# ========================================
# 普通开发使用 dev；rag Profile 仅加载RAG配置，仍须显式启用业务开关。
SPRING_PROFILES_ACTIVE=dev

# ========================================
# 数据库配置 (MySQL 8.0)
# ========================================
# MySQL root 用户密码（管理员密码）
MYSQL_ROOT_PASSWORD=

# 应用使用的数据库名称
MYSQL_DATABASE=chen_stack

# 应用连接数据库的用户名
MYSQL_USER=chenstack

# 应用连接数据库的密码
MYSQL_PASSWORD=

# MySQL 宿主端口，容器内端口为 3306
MYSQL_PORT=3308

# ========================================
# Redis 缓存配置
# ========================================
# Redis ACL 用户名，与实例 redis/users.acl 和后端一致
REDIS_USERNAME=chenstack

# Redis 访问密码
REDIS_PASSWORD=

# Redis 对外暴露的端口（默认 6379）
REDIS_PORT=6379

# ========================================
# MinIO 对象存储配置
# ========================================
# MinIO 访问密钥（用于文件上传存储）
MINIO_ACCESS_KEY=chenstack

# MinIO 密钥
MINIO_SECRET_KEY=

# MinIO API 端口（默认 9000）
MINIO_API_PORT=9000

# MinIO 控制台端口（默认 9001）
MINIO_CONSOLE_PORT=9001

# 浏览器可达的 MinIO 地址，用于生成文件 URL
MINIO_PUBLIC_POINT=http://localhost:9000

# ========================================
# RabbitMQ 消息队列配置
# ========================================
# RabbitMQ 管理员用户名（用于异步消息处理）
RABBITMQ_DEFAULT_USER=chenstack

# RabbitMQ 管理员密码
RABBITMQ_DEFAULT_PASS=

# RabbitMQ 服务端口（默认 5672）
RABBITMQ_PORT=5672

# RabbitMQ 管理界面端口（默认 15672）
RABBITMQ_MANAGEMENT_PORT=15672

# ========================================
# AI 服务配置 (DeepSeek)
# ========================================
# DeepSeek API Key（用于 AI 功能，如文章摘要生成）
# 获取方式见 DeepSeek API 文档：https://api-docs.deepseek.com/
SPRING_AI_OPENAI_API_KEY=

# 本地一键部署在 .runtime 下创建持久目录，应用首次启动时创建账本。
NORMAL_AI_USAGE=true

# DeepSeek API 地址（默认使用官方地址）
SPRING_AI_OPENAI_BASE_URL=https://api.deepseek.com

# 模型名称需要与 API 地址及账号权限匹配
SPRING_AI_OPENAI_CHAT_OPTIONS_MODEL=deepseek-flash

# ========================================
# 小辰 AI 知识模式配置（G3）
# ========================================
# 三档产品模式（管理员也可在「AI知识管理 → AI配置」页面在线切换，数据库配置优先）：
#   rag    : 只使用已审校的原始知识目录（需要 Embedding 凭据 + Qdrant + 已完成的知识发布）
#   wiki   : 只使用当前已发布且来源有效的 Wiki 正文（手动发布无需 Embedding）
#   hybrid : 智能混合——按问题在 RAG / Wiki 之间按需选择，简单交流不检索知识
# 历史值 chat 仍可被读取（纯对话），但已不是可选产品模式。
AI_KNOWLEDGE_MODE=hybrid

# Wiki 产品（整理知识）需要先执行 sql/g3_wiki_*.sql 迁移；一键部署脚本会自动执行。
CHEN_WIKI_ENABLED=true
CHEN_WIKI_PRODUCT_ENABLED=true
CHEN_WIKI_COMPILER_ENABLED=false
# 只控制公开 Wiki 阅读入口及 API，不影响后台审核或小辰的合法知识读取。
WIKI_PUBLIC_PORTAL_ENABLED=false

# 每位用户的小辰每日消息额度（北京时间自然日恢复，三档模式共用）。
CHEN_STACK_AI_DAILY_LIMIT=100

# ---- RAG（可选，默认关闭）----
# -WithRag 仅初始化本地 Qdrant。空的 Embedding Key 会让后端保持 RAG 关闭。
# 正式读取还需 rag profile、RAG 开关、独立 Embedding Key、有效发布和恢复授权。
CHEN_RAG_ENABLED=false
CHEN_RAG_EMBEDDING_API_KEY=
# 中国内地（北京）通用地址示例；按自己的服务区域和凭据调整。
CHEN_RAG_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHEN_RAG_EMBEDDING_MODEL=text-embedding-v4
# 本地一键部署使用 compose profile=rag 的内置 Qdrant；正式环境请指向独立 Qdrant。
CHEN_RAG_QDRANT_HOST=qdrant
CHEN_RAG_QDRANT_GRPC_PORT=6334
CHEN_LOCAL_QDRANT_GRPC_PORT=16334
CHEN_RAG_QDRANT_HTTP_PORT=16333
CHEN_RAG_QDRANT_TLS=false
CHEN_RAG_QDRANT_API_KEY=
CHEN_RAG_QDRANT_COLLECTION=chen_platform_help_v1

# ========================================
# 邮件服务配置
# ========================================
# 发送邮件的邮箱地址（用于用户注册、密码重置等功能）
# 当前应用默认 SMTP 主机为 smtp.qq.com；其他主机需自定义部署配置。
MAIL_USERNAME=your-email@qq.com

# 邮箱密码或授权码
# QQ邮箱：需要使用授权码，不是QQ密码
MAIL_PASSWORD=

# ========================================
# 前端地址配置
# ========================================
# 用户端前端地址
FRONTEND_USER_HOST=http://localhost:7000/

# 管理端前端地址
FRONTEND_ADMIN_HOST=http://localhost:8000/

# ========================================
# 阿里云服务配置
# ========================================
# 阿里云 AccessKey ID（用于图片内容安全检测）
# 获取方式：阿里云控制台 -> 用户信息 -> AccessKey 管理
ALIYUN_ACCESS_KEY_ID=

# 阿里云 AccessKey Secret
ALIYUN_ACCESS_KEY_SECRET=

# ========================================
# 应用自定义配置
# ========================================
# JWT 令牌签名密钥（用于用户身份认证）
# 生产环境请使用复杂的随机字符串
CHEN_STACK_JWT_SECRET=

# 图片自动审核开关
CHEN_STACK_PHOTO_AUTO_AUDIT=false

# 文章自动审核开关
CHEN_STACK_ARTICLE_AUTO_AUDIT=true

# 专栏自动审核开关
CHEN_STACK_COLUMN_AUTO_AUDIT=false

# 评论自动审核开关
CHEN_STACK_COMMENT_AUTO_AUDIT=false

# 限流开关（压力测试时设为 false）
CHEN_STACK_RATE_LIMIT_ENABLED=true

# ========================================
# 应用服务端口配置
# ========================================
# 后端 API 服务端口（默认 5000）
BACKEND_PORT=5000

# 管理端前端端口（默认 8000）
ADMIN_PORT=8000

# 用户端前端端口（默认 7000）
USER_PORT=7000


# ========================================
# 端口冲突时，新安装可用 -Instance chenstack-test -PortBase 29100，
# 由脚本配置隔离端口、前端 API 地址及后端允许的来源。
# 已有实例的端口变更需要重建相关容器，普通应用升级不会修改基础服务端口。

# 可选的独立 Qdrant 文件是 script/dev/docker-compose-rag.yml。
# 正式发布需要核对容器网络可达性、TLS、独立 Key 和目标集合，
# 不能只改 CHEN_RAG_QDRANT_HOST 后复用本地 profile 的设置。
