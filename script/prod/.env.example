# ========================================
# 辰栈环境变量配置文件示例
# ========================================
#
# 使用说明：
# 1. 将本模板复制为 script/prod/.env；勿复用后端或开发目录的私人配置
# 2. 根据您的实际环境修改下面的配置
# 3. 使用本目录选定的 Compose 文件；生产部署由用户在审查通过后执行
#
# 注意事项：
# - .env 文件包含敏感信息，不应提交到 Git 仓库
# - 生产环境请务必修改所有默认密码
# - 邮件和阿里云配置需要填入真实的账号信息
#
# ========================================

# ========================================
# Spring Boot 应用配置
# ========================================
# Spring Boot 激活的配置文件
# 普通容器使用 docker；rag Profile 仅加载RAG配置，仍须显式启用业务开关。
SPRING_PROFILES_ACTIVE=docker

# ========================================
# 数据库配置 (MySQL 8.0)
# ========================================
# MySQL root 用户密码（管理员密码）
MYSQL_ROOT_PASSWORD=root

# 应用使用的数据库名称
MYSQL_DATABASE=chen_stack

# 应用连接数据库的用户名
MYSQL_USER=chenstack

# 应用连接数据库的密码
MYSQL_PASSWORD=chenstack123

# MySQL 对外暴露的端口（默认 3306）
MYSQL_PORT=3306

# ========================================
# Redis 缓存配置
# ========================================
# Redis 用户名（用于缓存和会话存储）
REDIS_USERNAME=chenstack

# Redis 访问密码
REDIS_PASSWORD=chenstack123

# Redis 对外暴露的端口（默认 6379）
REDIS_PORT=6379

# ========================================
# MinIO 对象存储配置
# ========================================
# MinIO 访问密钥（用于文件上传存储）
MINIO_ACCESS_KEY=minioadmin

# MinIO 密钥
MINIO_SECRET_KEY=minioadmin123

# MinIO API 端口（默认 9000）
MINIO_API_PORT=9000

# MinIO 控制台端口（默认 9001）
MINIO_CONSOLE_PORT=9001

# MinIO 公网访问地址（用于生成文件访问 URL）
# 生产环境使用 HTTPS 域名访问
MINIO_PUBLIC_POINT=https://image.your-domain.com

# 开发环境示例（如果需要本地测试）：
# MINIO_PUBLIC_POINT=http://localhost:9000

# ========================================
# RabbitMQ 消息队列配置
# ========================================
# RabbitMQ 管理员用户名（用于异步消息处理）
RABBITMQ_DEFAULT_USER=admin

# RabbitMQ 管理员密码
RABBITMQ_DEFAULT_PASS=admin123

# RabbitMQ 服务端口（默认 5672）
RABBITMQ_PORT=5672

# RabbitMQ 管理界面端口（默认 15672）
RABBITMQ_MANAGEMENT_PORT=15672

# ========================================
# AI 服务配置（DeepSeek API）
# ========================================
# DeepSeek API 密钥
# 获取方式：https://platform.deepseek.com/ -> API Keys
# 功能：智能提取文章摘要
# 配额限制：每个用户每天最多调用 50 次（硬编码）
SPRING_AI_OPENAI_API_KEY=your-deepseek-api-key

# DeepSeek API 端点（默认使用官方地址，一般无需修改）
SPRING_AI_OPENAI_BASE_URL=https://api.deepseek.com

# 默认：deepseek-flash（V4.1 Flash）
# 可选：deepseek-v4-pro
SPRING_AI_OPENAI_CHAT_OPTIONS_MODEL=deepseek-flash

# 百炼 Embedding（北京，Workspace ID=ws-oy47ndolze5z0j6p，兼容接口，固定1024维）
# Compose 从本目录 .env 读取并传入后端；仅填写独立Key不会启用RAG或同步知识。
# 未来启用须显式设置 SPRING_PROFILES_ACTIVE=docker,rag 与 CHEN_RAG_ENABLED=true。
# DeepSeek Chat Key、百炼 Embedding Key、内容审核 ALIYUN_ACCESS_KEY_* 三套凭据互不复用。
CHEN_RAG_ENABLED=false
CHEN_RAG_EMBEDDING_API_KEY=
CHEN_RAG_EMBEDDING_BASE_URL=https://ws-oy47ndolze5z0j6p.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
CHEN_RAG_EMBEDDING_MODEL=text-embedding-v4

# ========================================
# 邮件服务配置
# ========================================
# 发送邮件的邮箱地址（用于用户注册、密码重置等功能）
# 支持：QQ邮箱、Gmail、163邮箱等
MAIL_USERNAME=your-email@qq.com

# 邮箱密码或授权码
# QQ邮箱：需要使用授权码，不是QQ密码
# Gmail：需要开启两步验证并生成应用专用密码
MAIL_PASSWORD=your-email-password

# ========================================
# 前端地址配置
# ========================================
# 用户端前端地址
FRONTEND_USER_HOST=http://localhost:7000/

# 管理端前端地址
FRONTEND_ADMIN_HOST=http://localhost:8000/

# ========================================
# 阿里云服务配置
# ========================================
# 阿里云 AccessKey ID（用于图片内容安全检测）
# 获取方式：阿里云控制台 -> 用户信息 -> AccessKey 管理
ALIYUN_ACCESS_KEY_ID=your-access-key-id

# 阿里云 AccessKey Secret
ALIYUN_ACCESS_KEY_SECRET=your-access-key-secret

# ========================================
# 应用自定义配置
# ========================================
# JWT 令牌签名密钥（用于用户身份认证）
# 生产环境请使用复杂的随机字符串
CHEN_STACK_JWT_SECRET=chenstack_jwt_secret

# 限流开关（压力测试时设为 false）
CHEN_STACK_RATE_LIMIT_ENABLED=true

# 图片自动审核开关
CHEN_STACK_PHOTO_AUTO_AUDIT=false

# 文章自动审核开关
CHEN_STACK_ARTICLE_AUTO_AUDIT=false

# 评论自动审核开关
CHEN_STACK_COMMENT_AUTO_AUDIT=false


# ========================================
# 应用服务端口配置
# ========================================
# 后端 API 服务端口（默认 5000）
BACKEND_PORT=5000

# 管理端前端端口（默认 8000）
ADMIN_PORT=8000

# 用户端前端端口（默认 7000）
USER_PORT=7000

# 项目根目录路径
PROJECT_ROOT=/opt/zcx-chen-stack


# ========================================
# 配置修改建议
# ========================================
#
# 开发环境建议：
# - 可以使用默认密码和端口进行本地开发
# - 邮件配置可以先跳过，使用测试邮箱
# - 端口冲突时可以修改为其他端口
#
# 生产环境必须修改：
# - 所有密码都要使用强密码（包含大小写字母、数字、特殊字符）
# - CHEN_STACK_JWT_SECRET 使用长随机字符串
# - 邮件配置填入真实可用的邮箱
# - 阿里云配置填入真实的 AccessKey
# - AI 服务配置填入真实的 DeepSeek API Key
# - 根据服务器情况调整端口配置
#
# 强密码示例：
# MYSQL_ROOT_PASSWORD=MySecure123!@#
# REDIS_PASSWORD=Redis456$%^
# CHEN_STACK_JWT_SECRET=MyVeryLongAndSecureJwtSecret2024!@#$
#



# 端口配置示例（避免冲突）：
# MYSQL_PORT=33061
# REDIS_PORT=63791
# MINIO_API_PORT=90001
# MINIO_CONSOLE_PORT=90011
# RABBITMQ_PORT=56721
# RABBITMQ_MANAGEMENT_PORT=156721
# BACKEND_PORT=50001
# ADMIN_PORT=80001
# USER_PORT=70001
#
# ========================================

# Qdrant独立部署：容器内开启RAG时必须填写后端容器可达的地址与端口。
# 127.0.0.1仅适用于后端进程与Qdrant同机直连；Docker不会自动连通独立RAG网络。
# docker-compose-rag.yml默认向宿主机映射gRPC 16334；按实际部署修改，不自动创建生产索引。
CHEN_RAG_QDRANT_HOST=127.0.0.1
CHEN_RAG_QDRANT_GRPC_PORT=6334
CHEN_RAG_QDRANT_TLS=false
CHEN_RAG_QDRANT_API_KEY=
CHEN_RAG_QDRANT_COLLECTION=chen_platform_help_v1
