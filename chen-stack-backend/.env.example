# ========================================
# 辰栈后端环境变量配置示例
# ========================================
# 注意：此文件为配置模板，不包含真实敏感信息
#
# 使用说明：
# 1. 将本模板复制为同目录 .env，直接运行后端时工作目录设为 chen-stack-backend
# 2. 根据您的实际环境修改下面的配置
# 3. 生产环境请务必修改所有默认密码和密钥
#
# ========================================

# ========================================
# 数据库配置 (MySQL)
# ========================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=chen_stack
MYSQL_USERNAME=root
MYSQL_PASSWORD=root

# ========================================
# Redis 配置
# ========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# ========================================
# 邮件配置 (QQ 邮箱)
# ========================================
MAIL_USERNAME=your-email@qq.com
MAIL_PASSWORD=your-email-password

# ========================================
# RabbitMQ 配置
# ========================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
# 本地不启动 RabbitMQ 时可改为 false，避免监听器循环重连刷日志
RABBITMQ_LISTENER_AUTO_STARTUP=true

# ========================================
# AI 服务配置 (DeepSeek API)
# ========================================
# 获取方式：https://platform.deepseek.com/api_keys
SPRING_AI_OPENAI_API_KEY=your-deepseek-api-key
SPRING_AI_OPENAI_BASE_URL=https://api.deepseek.com
# 默认：deepseek-flash（V4.1 Flash）
# 可选：deepseek-v4-pro
SPRING_AI_OPENAI_CHAT_OPTIONS_MODEL=deepseek-flash

# 百炼 Embedding（北京，Workspace ID=ws-oy47ndolze5z0j6p，兼容接口，固定1024维）
# 本地启动工作目录为 chen-stack-backend；.env 按 Java properties 加载，值不要加引号或 export。
# 仅填写独立Key不会启用RAG或同步知识；未来启用须显式设置 dev,rag 与 CHEN_RAG_ENABLED=true。
# DeepSeek Chat Key、百炼 Embedding Key、内容审核 ALIYUN_ACCESS_KEY_* 三套凭据互不复用。
SPRING_PROFILES_ACTIVE=dev
CHEN_RAG_ENABLED=false
CHEN_RAG_EMBEDDING_API_KEY=
CHEN_RAG_EMBEDDING_BASE_URL=https://ws-oy47ndolze5z0j6p.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
CHEN_RAG_EMBEDDING_MODEL=text-embedding-v4

# ========================================
# MinIO 配置
# ========================================
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_POINT=http://localhost:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123456

# ========================================
# 前端地址
# ========================================
FRONTEND_USER_HOST=http://localhost:7000/
FRONTEND_ADMIN_HOST=http://localhost:8000/

# ========================================
# 阿里云内容审核
# ========================================
ALIYUN_ACCESS_KEY_ID=your-access-key-id
ALIYUN_ACCESS_KEY_SECRET=your-access-key-secret

# ========================================
# 辰栈业务配置
# ========================================
# JWT 密钥 - 生产环境请使用复杂随机字符串
CHEN_STACK_JWT_SECRET=your_jwt_secret_key
# 限流开关，压力测试时设为 false
CHEN_STACK_RATE_LIMIT_ENABLED=true
# 自动审核配置
CHEN_STACK_PHOTO_AUTO_AUDIT=false
CHEN_STACK_ARTICLE_AUTO_AUDIT=false
CHEN_STACK_COMMENT_AUTO_AUDIT=false

# Qdrant独立部署：容器内开启RAG时必须填写后端容器可达的地址与端口。
# 127.0.0.1仅适用于后端进程与Qdrant同机直连；Docker不会自动连通独立RAG网络。
# docker-compose-rag.yml默认向宿主机映射gRPC 16334；按实际部署修改，不自动创建生产索引。
CHEN_RAG_QDRANT_HOST=127.0.0.1
CHEN_RAG_QDRANT_GRPC_PORT=6334
CHEN_RAG_QDRANT_TLS=false
CHEN_RAG_QDRANT_API_KEY=
CHEN_RAG_QDRANT_COLLECTION=chen_platform_help_v1
